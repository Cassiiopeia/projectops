# With text=True alone, Windows decodes as cp949. Decoding fails on Korean output and stdout becomes None (every CLI breaks in a repo under a Korean folder)
description=subprocess text=True must also set encoding or errors
paths=scripts/,skills/,plugins/,hooks/,.github/scripts/,.github/util/
extensions=.py
pattern=capture_output=True,\s*text=True(?![^)]*(?:encoding|errors)=)
