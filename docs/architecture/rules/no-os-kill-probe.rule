# No os.kill(pid, 0) liveness probe: on Windows it terminates the process. Use the single OS-branching point common/proc.pid_alive
description=No os.kill(pid, 0) liveness probe (terminates the process on Windows) — only scripts/common/proc.py may use it
paths=scripts/,skills/,plugins/,.github/scripts/
extensions=.py
# proc.py: the single OS-branching point that honors this ban (+ the extras copy, generated by sync_extras.py) · test_launch_architecture.py: docstring explaining this ban
exclude=scripts/common/proc.py,plugins/projectops-extras/skills/pro-remote-link/scripts/tunnel/proc.py,skills/pro-launch/tests/test_launch_architecture.py
pattern=os\.kill\([^\n]+?,\s*0\)
