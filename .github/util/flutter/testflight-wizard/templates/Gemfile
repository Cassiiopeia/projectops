# Fastlane - iOS build automation
# Officially supported on Ruby 3.4+ (2.228+)
gem "fastlane", ">= 2.240"  # 2.240+ reads the Xcode 27 altool upload result correctly (fastlane#30586); needs Ruby 3.2+

# multi_json - works around an upstream bug where a google-apis transitive dependency is undeclared in its gemspec (prevents Gem::LoadError)
