# ============================================================
# iOS Fastfile (TestFlight upload + automatic App Store review submission)
# ============================================================
# ★ The wizard (testflight-wizard.py setup) installs this file as ios/fastlane/Fastfile,
#   and the GitHub Actions workflow (PROJECT-FLUTTER-IOS-TESTFLIGHT.yaml) runs it as is.
#   (Same "installed file = running file" structure as Android's Fastfile.playstore)
#
# Deploy mode (DEPLOY_MODE) — recognizes both the shared names and iOS backward-compatible aliases:
#   store_only    (= testflight_only, default) : up to the TestFlight upload only
#   store_prepare (= appstore_prepare)         : TestFlight + create ASC version, select build, fill What's New (just before submission)
#   store_submit  (= appstore_submit)          : all of the above + automatic review submission (submit_for_review)
#
# Release mode (STORE_RELEASE_MODE, #1125) — who releases after approval (meaningful only for store_submit):
#   auto   (default) : released automatically on approval (automatic_release: true)
#   manual           : after approval a person presses 'Release this version' in App Store Connect (automatic_release: false)
#
# ⚠️ A new app needs one manual submission in App Store Connect first.
#   From the following updates, store_submit submits fully automatically.
#
# Store text (used only for store_prepare / store_submit):
#   'What's New'        : the workflow env STORE_WHATS_NEW_OVERRIDE if set, else CHANGELOG
#   Review notes (Notes): contents of ios/fastlane/review_notes.txt if present, else the existing ASC value stays
# ============================================================
default_platform(:ios)

# >>> store-text — text decision rules. A test (test_store_whats_new.py) runs only this block.
# Returns the 'What's New' text and its source. A whitespace-only value counts as missing.
def resolve_whats_new(override, changelog)
  default_notes = "버그를 수정하고 안정성을 개선했습니다."
  o = (override || "").strip
  return [o, "STORE_WHATS_NEW_OVERRIDE override"] unless o.empty?
  c = (changelog || "").strip
  return [c, "CHANGELOG"] unless c.empty?
  [default_notes, "default text"]
end

# Reads per-language 'What's New' text (#829). The folder (STORE_NOTES_DIR) is created by store_notes.py and
# file names are App Store Connect language codes (ko.txt, en-US.txt, ja.txt, zh-Hans.txt).
# nil if the folder is missing or empty — then the caller keeps the old behavior (one text for all DELIVER_LOCALES).
# Repos without store_locales in version.yml never get the folder, so nothing changes.
def resolve_locale_notes(dir)
  return nil if dir.nil? || dir.strip.empty? || !Dir.exist?(dir)
  notes = {}
  Dir.children(dir).sort.each do |name|
    next unless name.end_with?(".txt")
    text = File.read(File.join(dir, name)).strip
    notes[File.basename(name, ".txt")] = text unless text.empty?
  end
  notes.empty? ? nil : notes
end

# Contents of the review notes source file. nil if missing or empty — then notes.txt must not be created so the ASC value stays.
# (deliver does not send an empty notes.txt, so it cannot 'reset' either — measured)
def resolve_review_notes(path)
  return nil unless File.file?(path)
  text = File.read(path).strip
  text.empty? ? nil : text
end
# <<< store-text

# Version waiting for review / in review > that version string. A failed lookup counts as locked too (do not touch what is unknown)
# deliver changes the version label and metadata first and then fails at build selection, so block it before that
def find_version_locked_by_review(app_id)
  review_locked_states = ["WAITING_FOR_REVIEW", "IN_REVIEW"]
  app = Spaceship::ConnectAPI::App.find(app_id)
  return nil if app.nil?
  versions = app.get_app_store_versions(filter: { platform: "IOS" })
  # Check both the new (appVersionState) and old (appStoreState) state fields
  locked = versions.find do |version|
    states = [:app_version_state, :app_store_state].filter_map { |field| version.respond_to?(field) ? version.public_send(field) : nil }
    states.any? { |state| review_locked_states.include?(state) }
  end
  locked&.version_string
rescue StandardError => e
  UI.important("Could not read the App Store review state (#{e.class})")
  "unknown"
end

platform :ios do
  desc "TestFlight upload (+ automatic App Store review submission when DEPLOY_MODE=store_submit)"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["API_KEY_PATH"]
    )

    app_id = ENV["APP_IDENTIFIER"]
    UI.user_error!("The APP_IDENTIFIER (bundle ID) env var is required.") if app_id.nil? || app_id.strip.empty?

    deploy_mode = (ENV["DEPLOY_MODE"] || "testflight_only").strip
    prepare_appstore = ["appstore_prepare", "appstore_submit", "store_prepare", "store_submit"].include?(deploy_mode)
    submit_to_appstore = ["appstore_submit", "store_submit"].include?(deploy_mode)
    # Release mode: auto (current behavior) is the default even when the lane is called without the workflow. Typos stop instead of silently becoming auto
    release_mode = (ENV["STORE_RELEASE_MODE"] || "auto").strip
    release_mode = "auto" if release_mode.empty?
    unless ["auto", "manual"].include?(release_mode)
      UI.user_error!("STORE_RELEASE_MODE must be auto or manual (got: '#{release_mode}')")
    end
    # store_prepare does not turn on automatic release as before (a person submits)
    automatic_release = submit_to_appstore && release_mode == "auto"
    UI.message("🎛️  Deploy mode: #{deploy_mode} (ASC version prep: #{prepare_appstore} / automatic review submission: #{submit_to_appstore})")
    UI.message("🚦 Release mode: #{release_mode} (automatic release after approval: #{automatic_release})")

    # 1) TestFlight upload (always). In ASC prepare/submit modes, wait until build processing finishes.
    #    ⚠️ Apple Processing (build processing) usually takes 5-15 minutes, sometimes 1 hour+ (Apple's servers, out of our control).
    #       store_prepare/store_submit depend on this wait. Use store_only when in a hurry.
    pilot(
      api_key: api_key,
      app_identifier: app_id,
      ipa: ENV["IPA_PATH"],
      changelog: ENV["RELEASE_NOTES"],
      skip_waiting_for_build_processing: !prepare_appstore,
      distribute_external: false,
      notify_external_testers: false,
      uses_non_exempt_encryption: false
    )
    puts "✅ TESTFLIGHT upload done!"

    locked_version = prepare_appstore ? find_version_locked_by_review(app_id) : nil

    # 2) Prepare the App Store version (+ automatic review submission for store_submit)
    if locked_version
      UI.important("Skipped the App Store step: version #{locked_version} is waiting for or in review. TestFlight upload is done. Deploy again after review.")
    elsif prepare_appstore
      app_ver = ENV["APP_VERSION"]
      # 'What's New' text: the override value if set, else CHANGELOG (RELEASE_NOTES).
      # See the workflow env comment for why to override. TestFlight What to Test always uses CHANGELOG via pilot above.
      release_notes, notes_source = resolve_whats_new(ENV["STORE_WHATS_NEW_OVERRIDE"], ENV["RELEASE_NOTES"])
      UI.message("📝 whatsNew source: #{notes_source}")

      # Write the whatsNew metadata with absolute paths (relative paths disagree with fastlane's CWD → blank → submission rejected).
      # Creates only release_notes.txt and no other metadata → existing ASC metadata (description, keywords, etc.) is kept.
      workspace = ENV["GITHUB_WORKSPACE"] || Dir.pwd
      metadata_path = File.join(workspace, "ios", "fastlane", "metadata")
      require "fileutils"
      # ⚠️ Locale directory names must be codes deliver accepts (ko valid, ko-KR invalid).
      locale_notes = resolve_locale_notes(ENV["STORE_NOTES_DIR"])
      if locale_notes
        # Per-language text (#829). Languages without a translation were already filled with the default-language text by store_notes.py —
        # App Store Connect rejects review submission if any language has an empty What's New.
        locale_notes.each do |loc, text|
          dir = File.join(metadata_path, loc)
          FileUtils.mkdir_p(dir)
          File.write(File.join(dir, "release_notes.txt"), text)
          UI.message("📝 Writing whatsNew metadata [#{loc}]: #{text}")
        end
      else
        locales = (ENV["DELIVER_LOCALES"] || "ko").split(",").map(&:strip).reject(&:empty?)
        locales.each do |loc|
          dir = File.join(metadata_path, loc)
          FileUtils.mkdir_p(dir)
          File.write(File.join(dir, "release_notes.txt"), release_notes)
        end
        UI.message("📝 Writing whatsNew metadata: #{release_notes}")
      end

      # Review notes (Notes) use ios/fastlane/review_notes.txt as the source and get its content every time.
      # Apps without a shared review account keep login instructions only in Notes, and a mismatch there gets rejected, so it is managed with the code.
      # Without the file (or if empty), notes.txt is not created and the existing ASC value stays. Other review info such as contacts is untouched.
      notes_src = File.join(workspace, ENV["APP_ROOT"] || ".", "ios", "fastlane", "review_notes.txt")
      review_dir = File.join(metadata_path, "review_information")
      review_notes = resolve_review_notes(notes_src)
      if review_notes
        FileUtils.mkdir_p(review_dir)
        File.write(File.join(review_dir, "notes.txt"), review_notes)
        UI.message("📝 Writing review Notes: #{notes_src}")
      else
        FileUtils.rm_f(File.join(review_dir, "notes.txt"))
        UI.message("⏭️  No review_notes.txt — review Notes keep the existing ASC value")
      end

      UI.message("📂 metadata_path=#{metadata_path}")

      deliver(
        api_key: api_key,
        app_identifier: app_id,
        app_version: app_ver,
        build_number: ENV["BUILD_NUMBER"],
        submit_for_review: submit_to_appstore,
        automatic_release: automatic_release,          # with manual, a person releases after approval
        force: true,
        run_precheck_before_submit: false,
        skip_binary_upload: true,
        skip_metadata: false,
        metadata_path: metadata_path,
        skip_screenshots: true,
        precheck_include_in_app_purchases: false,
        submission_information: {
          add_id_info_uses_idfa: false
        }
      )
      if submit_to_appstore && !automatic_release
        puts "✅ Submitted for App Store review. Release mode manual: after approval, release this version in App Store Connect."
      elsif submit_to_appstore
        puts "✅ APP STORE review submitted automatically!"
      else
        puts "✅ APP STORE version ready (Prepare for Submission) — just press 'Add for Review' in ASC after checking to submit."
      end
    else
      puts "⏭️  store_only (testflight_only) mode — skipping App Store stages (TestFlight upload only)"
    end
  end
end
