{
  "description": "projectops: pro-launch 기기 — 세션이 끝나면 빌린 기기를 반납하고(#953), raw 기기 생성·삭제 명령을 막는다(#954)",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pro_launch_session_end.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pro_launch_raw_device_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
