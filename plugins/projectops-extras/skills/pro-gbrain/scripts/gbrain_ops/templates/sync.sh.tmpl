#!/bin/bash
# Team brain sync for __PROJECT__ (generated by /pro-gbrain; regenerate with `gbrain_cli.py repair`, do not edit by hand)
# Flow: pull the default branch (knowledge/ + root files only) > log merged work with no note > sync > extract links
# The writer connection lives in $GBRAIN_HOME/.gbrain/config.json (mode 600); nothing secret is in this file.
set -u
# First PATH entry: where gbrain was found when this script was generated (launchd and cron start with a bare PATH)
export PATH="__GBRAIN_DIR__:$HOME/.bun/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export GBRAIN_HOME="__GBRAIN_HOME__"
repo_dir="$GBRAIN_HOME/repo"
log_prefix="[__PROJECT__ brain]"

# Merged notes only: the sparse clone follows __BRANCH__, uncommitted work never reaches the brain
git -C "$repo_dir" pull --ff-only --quiet origin "__BRANCH__" || { echo "$log_prefix git pull failed"; exit 1; }

# Merged work with no note (git and note files only; a failure never stops the sync)
pro_brain_scripts=$(find "$HOME"/.claude*/plugins/cache "$HOME"/.codex/plugins/cache -maxdepth 7 -type d \
  -path '*/projectops-extras/*/skills/pro-brain/scripts' 2>/dev/null \
  | awk -F/ '{for(i=1;i<=NF;i++) if($i=="projectops-extras") print $(i+1)"\t"$0}' | sort -V | tail -1 | cut -f2-)
if [ -n "$pro_brain_scripts" ]; then
  { echo "[$(date '+%Y-%m-%d %H:%M:%S')]"; python3 "$pro_brain_scripts/brain_cli.py" gaps --repo "$repo_dir" --ref HEAD --format text; } \
    >> "$GBRAIN_HOME/gaps.log" 2>&1 || true
else
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] pro-brain scripts not found, gaps skipped" >> "$GBRAIN_HOME/gaps.log"
fi

gbrain sync --source "__SOURCE_ID__" --no-pull || { echo "$log_prefix gbrain sync failed"; exit 1; }
gbrain extract --stale --catch-up --source-id "__SOURCE_ID__" || echo "$log_prefix gbrain extract failed (sync kept)"
date '+%Y-%m-%dT%H:%M:%S' > "$GBRAIN_HOME/last-sync"
