{
  "github": {
    "default_assignee": "{GitHub_사용자명}",
    "global_pat": "{ghp_xxxxxxxxxxxxxxxxxxxx}",
    "commit": {
      "auto_approve": false
    },
    "issue": {
      "auto_approve": false
    },
    "changelog_deploy": {
      "auto_approve": false
    },
    "repos": [
      {
        "name": "{프로젝트 이름}",
        "owner": "{GitHub_사용자명_또는_조직명}",
        "repo": "{저장소명}",
        "pat": null,
        "default": true
      },
      {
        "name": "{다른 프로젝트}",
        "owner": "{GitHub_사용자명_또는_조직명}",
        "repo": "{저장소명}",
        "pat": "{ghp_별도PAT_있으면_입력}",
        "default": false,
        "commit": {
          "auto_approve": true
        },
        "issue": {
          "auto_approve": true,
          "assignee": "{이 레포만 다른 담당자 GitHub 사용자명}"
        },
        "changelog_deploy": {
          "auto_approve": true,
          "app_release": true
        }
      }
    ]
  },
  "output": {
    "_주석": "산출물(md) 저장 루트. 생략하면 docs/projectops 를 쓴다. 상대경로는 저장소 루트 기준, 절대경로도 가능.",
    "root": "docs/projectops"
  },
  "synology-expose": {
    "instances": [
      {
        "name": "{NAS 식별 이름}",
        "ddns": "{your-nas.synology.me}",
        "domains": [
          "{example.com}"
        ],
        "email": "{your@email.com}",
        "dns_provider": "{cloudflare|route53|gabia}",
        "default": true
      }
    ]
  },
  "launch": {
    "credentials": {
      "my-server": {
        "kind": "ssh",
        "host": "{your-server.example.com}",
        "port": 22,
        "user": "{username}",
        "password": "{비밀번호 — 키 접속이면 \"key_path\": \"~/.ssh/id_ed25519\" 로}",
        "scope": "test-only",
        "use_when": "{언제 써도 되는지 — 사용자가 허용한 범위 그대로}",
        "notes": "{지켜야 할 이름 규칙 · 포트 범위 · 서버에 있는 운영 서비스}"
      },
      "my-registry": {
        "kind": "dockerhub",
        "username": "{username}",
        "token": "{access token}",
        "scope": "test-only",
        "use_when": "{예: 배포 워크플로 테스트에서 Secret 으로 등록할 때}"
      }
    }
  }
}
